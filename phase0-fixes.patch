+/* Scan source only. Tailwind v4 otherwise scans every non-ignored file in the
+   repo, and class names quoted in docs/*.md end up compiled into the bundle. */
+@source "../**/*.{ts,tsx}";
+
+/* ---------------------------------------------------------------------------
+   Tailwind reads the RECESS tokens here. `inline` matters: it substitutes the
+   variable into each utility instead of emitting a copy, so `bg-ground` on a
+   night Surface resolves against that element's --ground, not the root's.
+
+   Adding a colour means editing tokens.css, not this block, and never writing
+   an arbitrary value like bg-[#e63368] in a component. ESLint blocks raw hex.
+   --------------------------------------------------------------------------- */
+@theme inline {
+  --color-paper: var(--paper);
+  --color-paper-deep: var(--paper-deep);
+  --color-ink: var(--ink);
+  --color-ink-soft: var(--ink-soft);
+  --color-aubergine: var(--aubergine);
+  --color-aubergine-lift: var(--aubergine-lift);
+  --color-pink: var(--pink);
+  --color-pink-deep: var(--pink-deep);
+  --color-amber: var(--amber);
+
+  /* Semantic. These follow whichever Surface the element sits inside. */
+  --color-ground: var(--ground);
+  --color-ground-lift: var(--ground-lift);
+  --color-fg: var(--fg);
+  --color-fg-soft: var(--fg-soft);
+  --color-fg-line: var(--fg-line);
+  --color-fg-faint: var(--fg-faint);
+  --color-fg-muted: var(--fg-muted);
+  --color-fg-placeholder: var(--fg-placeholder);
+  --color-field: var(--field-fill);
+
+  --font-display: var(--font-display-family);
+  --font-ui: var(--font-ui-family);
+
+  /* 12 14 16 20 28 40 64 96 */
+  --text-rc-xs: 0.75rem;
+  --text-rc-xs--line-height: 1.4;
+  --text-rc-sm: 0.875rem;
+  --text-rc-sm--line-height: 1.5;
+  --text-rc-base: 1rem;
+  --text-rc-base--line-height: 1.55;
+  --text-rc-md: 1.25rem;
+  --text-rc-md--line-height: 1.3;
+  --text-rc-lg: 1.75rem;
+  --text-rc-lg--line-height: 1.15;
+  --text-rc-xl: 2.5rem;
+  --text-rc-xl--line-height: 0.95;
+  --text-rc-2xl: 4rem;
+  --text-rc-2xl--line-height: 0.9;
+  --text-rc-3xl: 6rem;
+  --text-rc-3xl--line-height: 0.86;
+
+  --radius-rc: var(--rc-radius);
+  --radius-rc-sm: var(--rc-radius-sm);
+
+  --spacing-tap: var(--rc-tap);
+
+  /* The physical press on primary buttons. */
+  --shadow-press: 0 3px 0 var(--pink-deep);
+  --shadow-press-down: 0 0 0 var(--pink-deep);
+}
 
